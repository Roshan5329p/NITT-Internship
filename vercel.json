{
  "version": 2,
  "functions": {
    "api/predict.js": {
      "includeFiles": "data/pinn_ti64_weights.json"
    },
    "api/meltpool.js": {
      "includeFiles": "data/pinn_ti64_weights.json"
    }
  },
  "rewrites": [
    {
      "source": "/api/(stats|predict|evaluate|meltpool|bontha|materials|papers|scopus)/?",
      "destination": "/api/$1.js"
    },
    {
      "source": "/dashboard/?",
      "destination": "/process_windows_dashboard.html"
    },
    {
      "source": "/",
      "destination": "/process_windows_dashboard.html"
    }
  ]
}
